{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a2z2913/vp-research-core/schemas/electorate_record.schema.json",
  "title": "Sanitized electorate record",
  "type": "object",
  "required": ["rule_id", "state", "contest_type", "office", "counties", "district", "match", "source_urls", "checked", "election_date", "boundary_vintage", "effective_start", "effective_end", "source_revision"],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "state": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "contest_type": {"type": "string"},
    "office": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string"},
    "counties": {"type": "array", "items": {"type": "string"}},
    "district": {"type": "object"},
    "electorate": {"type": "string"},
    "levels": {"type": "array", "items": {"type": "string"}},
    "match": {"$ref": "electorate_rule.schema.json"},
    "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "checked": {"type": "string", "format": "date"},
    "election_date": {"type": "string", "format": "date"},
    "boundary_vintage": {"type": ["string", "null"]},
    "effective_start": {"type": ["string", "null"], "format": "date"},
    "effective_end": {"type": ["string", "null"], "format": "date"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  },
  "additionalProperties": false
}
